# Copy to .env (gitignored) and fill in. Never commit real values.

# Required
HF_TOKEN=
WANDB_API_KEY=
RUNPOD_API_KEY=

# Optional paid judge. The default judge runs open-weight (Llama-Guard-3-8B)
# on the pod, so these stay empty unless judge_provider is set to a paid API.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override the HuggingFace datasets cache location.
# HF_DATASETS_CACHE=
